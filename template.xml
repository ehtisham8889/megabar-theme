<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<Template isFullResponsive="true">
    <Name>Megabar Speed</Name>
    <Author></Author>
    <URL>https://www.megabar.de</URL>
    <Parent>NOVA</Parent>
    <Preview>preview.png</Preview>
    <Version>5.3.4</Version>
    <MinShopVersion>5.5.2</MinShopVersion>
    <Description>Das offizielle Megabar Template</Description>
    <Settings>
        <Section Name="Theme" Key="theme">
            <Setting Description="Theme" Key="theme_default" Type="select" Value="smoke2u" override="true">
                <Option Value="smoke2u">Smoke2u</Option>
            </Setting>
        </Section>
        <Section Name="smoke2u-Settings" Key="smokegeneralsettings">
            <Setting Description="Art des Shops" Key="smokeshoptype" Type="select" Value="B2C">
                <Option Value="B2C">B2C</Option>
                <Option Value="B2B">B2B</Option>
            </Setting>
            <Setting Description="Gefahrenhinweise anzeigen?" Key="smokeshowdanger" Type="select" Value="N">
                <Option Value="N">nein</Option>
                <Option Value="Y">ja</Option>
            </Setting>
            <Setting Description="Kategoriedarstellung" Key="smokecat" Type="select" Value="flame">
                <Option Value="flame">Flammen-Icon</Option>
                <Option Value="btn">Button-Style</Option>
                <Option Value="vanlla">default</Option>
            </Setting>
            <Setting Description="Kategoriefilter" Key="smokefilter" Type="select" Value="full">
                <Option Value="full">volle Breite (Achtung, Darstellungsfehler mit Sidebar)</Option>
                <Option Value="sidebar">angepasst für Sidebar</Option>
                <Option Value="modal">Modal (wie mobil)</Option>
            </Setting>
            <Setting Description="Ausnahmen vom Login" Key="excl" Type="text" Value=""/>
        </Section>
        <Section Name="Art der Suche" Key="smokesearch">
            <Setting Description="Art der Suche" Key="searchtype" Type="select" Value="default">
                <Option Value="default">standard</Option>
                <Option Value="icon">nur icon</Option>
            </Setting>
        </Section>
        <Section Name="smoke2u-Footer" Key="smokefootersettings">
            <Setting Description="Whatsapp-Button-Text Footer" Key="watext" Type="text" Value="WhatsApp Support"/>
            <Setting Description="Whatsapp-Button-Link Footer" Key="walink" Type="text" Value="https://www.google.de"/>
            <Setting Description="E-Mail-Button-Text Footer" Key="emtext" Type="text" Value="support@megabar.de"/>
            <Setting Description="E-Mail-Button-Link Footer" Key="emlink" Type="text" Value="mailto:support@megabar.de"/>
        </Section>
        <Section Name="Megabar Startseite" Key="megabarhome">
            <Setting Description="Neue Startseite (Vorschau: Startseite mit ?mbnew=1 aufrufen)" Key="mbhome" Type="select" Value="preview">
                <Option Value="off">Aus</Option>
                <Option Value="preview">Nur Vorschau mit ?mbnew=1</Option>
                <Option Value="on">An (für alle Besucher)</Option>
            </Setting>
        </Section>
    </Settings>
    <Minify>
        <CSS Name="smoke2u.css">
            <File Path="themes/smoke2u/smoke2u.css"/>
            <File Path="themes/smoke2u/custom.css"/>
        </CSS>
        <JS Name="jtl3.js">
            <File Path="js/jtl.evo.js" override="true" />
            <File Path="js/jtl.basket.js" override="true" />
            <File Path="js/jtl.article.js" override="true" />
            <File Path="js/wow.min.js" override="true" />
            <File Path="js/matchHeight.js" override="true" />
            <File Path="js/smoke2u.js" override="true" />
            
        </JS>
    </Minify>
    <Boxes>
        <Container Position="left" Available="1" />
        <Container Position="right" Available="0" />
        <Container Position="top" Available="1" />
        <Container Position="bottom" Available="1" />
    </Boxes>
</Template>
